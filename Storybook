# syntax=docker/dockerfile:1.4
FROM node:16-alpine AS builder

# Add a work directory
WORKDIR /app

# Cache and Install dependencies
COPY package.json .
COPY yarn.lock .
COPY .yarn .yarn
COPY .yarnrc.yml .yarnrc.yml
RUN --mount=type=secret,id=QOVERY_NPM_READ_TOKEN \
    if [ -f /run/secrets/QOVERY_NPM_READ_TOKEN ]; then \
      export QOVERY_NPM_READ_TOKEN="$(cat /run/secrets/QOVERY_NPM_READ_TOKEN)"; \
    fi && \
    yarn install --immutable

# Copy app files
COPY . .
# Build the app
RUN yarn build-storybook

# Bundle static assets with nginx
FROM nginx:latest
# Copy built assets from builder
COPY --from=builder /app/dist/storybook/* /usr/share/nginx/html
# Add your nginx.conf
COPY nginx.conf /etc/nginx/conf.d/default.conf
# Expose port
EXPOSE 80
# Start nginx
CMD ["nginx", "-g", "daemon off;"]
